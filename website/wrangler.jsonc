{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lexnur-website",
  "compatibility_date": "2026-10-01",
  "main": "worker/index.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // Every request goes through the worker so www.lexnur.com can be redirected before assets are served.
    "run_worker_first": true
  },
  "routes": [
    { "pattern": "lexnur.com", "custom_domain": true },
    { "pattern": "www.lexnur.com", "custom_domain": true }
  ]
}
