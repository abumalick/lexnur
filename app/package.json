{
  "name": "@lexnur/app",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:fixture": "VITE_DATA=fixture vite build --outDir dist-fixture",
    "preview:fixture": "vite preview --outDir dist-fixture --host 127.0.0.1 --port ${LEXNUR_PREVIEW_PORT:-4173} --strictPort",
    "test": "vitest run",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@capacitor-community/sqlite": "8.1.1",
    "@capacitor/android": "8.5.3",
    "@capacitor/app": "8.1.2",
    "@capacitor/clipboard": "8.0.1",
    "@capacitor/core": "8.5.3",
    "@capacitor/device": "8.0.3",
    "@capacitor/filesystem": "8.1.4",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/ios": "8.5.3",
    "@capacitor/keyboard": "8.0.6",
    "@capacitor/network": "8.0.1",
    "@capacitor/preferences": "8.0.1",
    "@capacitor/screen-reader": "8.0.1",
    "@capacitor/share": "8.0.3",
    "@capacitor/text-zoom": "8.0.1",
    "@fontsource/noto-naskh-arabic": "5.3.0",
    "@fontsource/noto-serif": "5.3.0",
    "@lexnur/core": "workspace:*",
    "@lexnur/native": "workspace:*",
    "@material/material-color-utilities": "0.4.0",
    "@sqlite.org/sqlite-wasm": "3.53.4-build2",
    "fzstd": "0.1.1"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "@playwright/test": "1.64.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@testing-library/svelte": "5.4.2",
    "@types/node": "26.6.5",
    "jsdom": "30.1.2",
    "svelte": "5.57.2",
    "svelte-check": "4.7.6",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
}
